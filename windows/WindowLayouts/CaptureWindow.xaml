<Window x:Class="WindowLayouts.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowLayouts" Width="660" Height="580" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Heading" Grid.Row="0" FontSize="18" FontWeight="Bold" />
        <TextBox x:Name="NameBox" Grid.Row="1" Margin="0,10,0,0" Padding="4" FontSize="13" TextChanged="NameBox_TextChanged" />
        <TextBlock x:Name="ConfigText" Grid.Row="2" Margin="0,8,0,0" Foreground="Gray" FontSize="11" />

        <StackPanel Grid.Row="3" Margin="0,8,0,8">
            <TextBlock x:Name="HintText" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
            <CheckBox x:Name="TitlesBox" Margin="0,6,0,0" FontSize="11" />
            <CheckBox x:Name="UrlsBox" Margin="0,4,0,0" FontSize="11" />
        </StackPanel>

        <Border Grid.Row="4" BorderBrush="#DDDDDD" BorderThickness="1" Background="White">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="GroupsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,6">
                                    <Button Content="{Binding HeaderText}" HorizontalAlignment="Left" Padding="4,2"
                                            Background="Transparent" BorderThickness="0" FontWeight="Bold"
                                            Click="GroupHeader_Click" />
                                    <ItemsControl ItemsSource="{Binding Windows}" Margin="20,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Margin="0,3">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="Gray" Visibility="Collapsed" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Width="90" IsCancel="True" DockPanel.Dock="Left" />
            <Button x:Name="SaveButton" Width="90" DockPanel.Dock="Right" IsDefault="True" Click="Save_Click" />
            <TextBlock x:Name="CountText" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" Foreground="Gray" />
        </DockPanel>
    </Grid>
</Window>
