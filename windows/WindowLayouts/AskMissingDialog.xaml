<Window x:Class="WindowLayouts.AskMissingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="창 배치" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock FontWeight="Bold" FontSize="14" Text="실행 중이 아니거나 창이 없는 앱이 있습니다" />
        <TextBlock x:Name="Message" Margin="0,8,0,12" TextWrapping="Wrap" />
        <CheckBox x:Name="RememberBox" Content="이 배치에서는 다시 묻지 않기" Margin="0,0,0,14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button Content="지금 있는 창만 배치" Width="140" Margin="0,0,8,0" Click="Skip_Click" />
            <Button Content="실행/창 열고 배치" Width="140" IsDefault="True" Click="Launch_Click" />
        </StackPanel>
    </StackPanel>
</Window>
