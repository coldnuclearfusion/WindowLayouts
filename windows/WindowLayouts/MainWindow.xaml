<Window x:Class="WindowLayouts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindowLayouts"
        Title="WindowLayouts" Width="1000" Height="640" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 사이드바 -->
        <DockPanel Grid.Column="0" Background="#F5F5F5">
            <DockPanel DockPanel.Dock="Top" Margin="8">
                <Button x:Name="CaptureButton" DockPanel.Dock="Right" Padding="8,3" Click="Capture_Click" />
                <TextBlock x:Name="SidebarTitle" FontWeight="Bold" VerticalAlignment="Center" />
            </DockPanel>
            <ListBox x:Name="Sidebar" BorderThickness="0" Background="Transparent"
                     SelectionChanged="Sidebar_SelectionChanged"
                     PreviewMouseRightButtonDown="Sidebar_PreviewMouseRightButtonDown"
                     ContextMenuOpening="Sidebar_ContextMenuOpening">
                <ListBox.ContextMenu>
                    <ContextMenu />
                </ListBox.ContextMenu>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                        <Setter Property="Padding" Value="10,5" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock x:Name="MainText" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SubText" Text="{Binding Sub}" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="header">
                                <Setter TargetName="MainText" Property="FontWeight" Value="Bold" />
                                <Setter TargetName="MainText" Property="FontSize" Value="11" />
                                <Setter TargetName="MainText" Property="Foreground" Value="#666666" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="empty">
                                <Setter TargetName="MainText" Property="Foreground" Value="Gray" />
                                <Setter TargetName="MainText" Property="FontSize" Value="11" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Sub}" Value="">
                                <Setter TargetName="SubText" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 상세 -->
        <Grid Grid.Column="1">
            <TextBlock x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480" />

            <Grid x:Name="DetailPanel" Margin="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Button x:Name="ApplyButton" DockPanel.Dock="Right" Padding="14,5" FontWeight="Bold" Click="Apply_Click" />
                    <TextBox x:Name="NameBox" FontSize="16" Padding="4" Margin="0,0,12,0"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock x:Name="PolicyLabel" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="PolicyCombo" MinWidth="190" SelectedValuePath="Value" DisplayMemberPath="Label"
                              SelectedValue="{Binding LaunchPolicy}" />
                </StackPanel>

                <CheckBox x:Name="RaiseCheck" Grid.Row="2" Margin="0,8,0,0" IsChecked="{Binding RaiseWindows}" />

                <DockPanel Grid.Row="3" Margin="0,8,0,8">
                    <Button x:Name="ChangeButton" DockPanel.Dock="Right" Padding="10,2" Click="DisplayChange_Click" />
                    <TextBlock x:Name="DisplayText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                </DockPanel>

                <DataGrid x:Name="WindowsGrid" Grid.Row="4" ItemsSource="{Binding Windows}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" SelectionMode="Extended" GridLinesVisibility="Horizontal"
                          RowHeight="26">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="" Width="30" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" />
                        <DataGridTextColumn x:Name="ColApp" Width="120" Binding="{Binding AppName}" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="ColTitle" Width="220" Binding="{Binding Title}" />
                        <DataGridTextColumn x:Name="ColUrl" Width="180" Binding="{Binding Url}" />
                        <DataGridTemplateColumn x:Name="ColMatch" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{x:Static local:MainWindow.TitleMatchItems}"
                                              SelectedValuePath="Value" DisplayMemberPath="Label"
                                              SelectedValue="{Binding TitleMatch, UpdateSourceTrigger=PropertyChanged}"
                                              BorderThickness="0" Background="Transparent" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="ColMonitor" Width="110" Binding="{Binding MonitorName}" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="ColX" Width="60" Binding="{Binding X}" />
                        <DataGridTextColumn x:Name="ColY" Width="60" Binding="{Binding Y}" />
                        <DataGridTextColumn x:Name="ColW" Width="60" Binding="{Binding Width}" />
                        <DataGridTextColumn x:Name="ColH" Width="60" Binding="{Binding Height}" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="AddWindowsButton" Padding="8,3" Margin="0,0,8,0" Click="AddWindows_Click" />
                    <Button x:Name="RefreshButton" Padding="8,3" Margin="0,0,8,0" Click="Refresh_Click" />
                    <Button x:Name="DeleteRowsButton" Padding="8,3" Margin="0,0,8,0" Click="DeleteRows_Click" />
                    <Button x:Name="UpButton" Content="▲" Padding="8,3" Margin="0,0,4,0" Click="MoveUp_Click" />
                    <Button x:Name="DownButton" Content="▼" Padding="8,3" Click="MoveDown_Click" />
                    <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Gray" FontSize="11" />
                </StackPanel>

                <TextBlock x:Name="RefreshText" Grid.Row="6" Foreground="Gray" FontSize="11" Margin="0,6,0,0" />

                <Border x:Name="ReportBox" Grid.Row="7" Background="#F3F3F3" CornerRadius="6" Padding="10" Margin="0,8,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ReportHeadline" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock x:Name="ReportLines" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer x:Name="GeneralPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock x:Name="LanguageHeading" FontWeight="Bold" />
                    <ComboBox x:Name="LanguageCombo" Width="240" HorizontalAlignment="Left" Margin="0,6,0,2"
                              SelectedValuePath="Code" DisplayMemberPath="Name" SelectionChanged="Language_Changed" />
                    <TextBlock x:Name="LanguageNote" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />

                    <TextBlock x:Name="StartupHeading" FontWeight="Bold" Margin="0,16,0,0" />
                    <CheckBox x:Name="StartupBox" Margin="0,6,0,2" Click="Startup_Click" />
                    <TextBlock x:Name="StartupError" Foreground="Red" FontSize="11" />

                    <TextBlock x:Name="DataHeading" FontWeight="Bold" Margin="0,16,0,0" />
                    <TextBlock x:Name="FilePathText" FontSize="11" Margin="0,6,0,6" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="OpenFileButton" Padding="8,3" Margin="0,0,8,0" Click="OpenFile_Click" />
                        <Button x:Name="OpenFolderButton" Padding="8,3" Margin="0,0,8,0" Click="OpenFolder_Click" />
                        <Button x:Name="ReloadButton" Padding="8,3" Margin="0,0,8,0" Click="Reload_Click" />
                        <Button x:Name="OpenLogButton" Padding="8,3" Click="OpenLog_Click" />
                    </StackPanel>
                    <TextBlock x:Name="JsonHint" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock x:Name="LoadErrorText" Foreground="Red" FontSize="11" />
                    <TextBlock x:Name="CliHint" FontSize="11" Foreground="Gray" Margin="0,6,0,0" TextWrapping="Wrap" />

                    <TextBlock x:Name="MonitorsHeading" FontWeight="Bold" Margin="0,16,0,0" />
                    <TextBlock x:Name="MonitorsText" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="MonitorsNote" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
